node_modules/
runtime/bin/
# lib/client.js is the plugin's hand-authored client entry, not a build output.
!lib/
.build/

# The pipeline writes these next to the masters: frames it also ships under
# assets/pet, and the layer dumps the debug previews draw. Both come back from
# `npm run skin`.
skin/frames/
skin/layers/

# The 1240 sprite frames the Helper draws, plus the manifest that lists them:
# build output from skin/, regenerated by `npm install` (scripts/ensure-assets.mjs).
assets/pet/
assets/pet-manifest.json
